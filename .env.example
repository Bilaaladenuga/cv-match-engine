# Career Match — Root Environment Variables

# PostgreSQL (local installation)
POSTGRES_USER=career_match
POSTGRES_PASSWORD=career_match
POSTGRES_DB=career_match
DATABASE_URL=postgresql://career_match:career_match@localhost:5432/career_match

# Backend
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
DEBUG=true

# Rate limiting (backend only). Rules are '<limit>/<period>', period in
# sec|min|hour. The ML endpoints are expensive — keep their limits tight on
# free-tier hosting. Set RATE_LIMIT_ENABLED=false to disable (local testing).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/min
RATE_LIMIT_MATCHES=5/min
RATE_LIMIT_RANKING=5/min

# Embedding model (ONNX Runtime via fastembed)
# Optional. Defaults to backend/models/all-MiniLM-L6-v2-onnx, populated by
# scripts/fetch_embedding_model.sh. Set to override the model directory, or
# set FASTEMBED_CACHE_DIR to change where fastembed caches a Hub download.
# EMBEDDING_MODEL_PATH=
# Limit ONNX inference threads (unset uses the onnxruntime default)
# EMBEDDING_THREADS=4

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
