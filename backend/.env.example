# Career Match — Backend Environment Variables

# Database
DATABASE_URL=postgresql://career_match:career_match@localhost:5432/career_match

# Authentication
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
APP_NAME=Career Match API
APP_VERSION=0.1.0
DEBUG=true

# File Upload
MAX_UPLOAD_SIZE_MB=10

# ML / Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_VERSION=match-model-v1.0

# CORS
CORS_ORIGINS=["http://localhost:3000"]
